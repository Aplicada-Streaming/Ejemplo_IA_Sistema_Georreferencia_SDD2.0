@page "/templates"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin_raiz,jefe_area")]
@inject ISgrApiClient Api
@inject NavigationManager Nav

<PageTitle>SGR — Plantillas</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Plantillas</MudText>
    <AuthorizeView Roles="admin_raiz" Context="auth">
        <Authorized>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/templates/new">
                Nueva plantilla
            </MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else if (_templates.Count == 0)
{
    <MudAlert Severity="Severity.Info">No hay plantillas cargadas.</MudAlert>
}
else
{
    <MudTable Items="_templates" Hover="true" Dense="true" Striped="true"
              OnRowClick="@((TableRowClickEventArgs<TemplateSummaryDto> e) => OpenVersion(e.Item!))"
              Style="cursor: pointer;">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Última actividad</MudTh>
        </HeaderContent>
        <RowTemplate Context="row">
            <MudTd>@row.Name</MudTd>
            <MudTd>
                @if (row.IsRoot)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Raíz</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small">Hija</MudChip>
                }
            </MudTd>
            <MudTd>
                @if (row.LatestPublishedVersionNumber is { } v)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Publicada v@v</MudChip>
                }
                @if (row.LatestDraftVersionNumber is { } d)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-1">Borrador v@d</MudChip>
                }
                @if (row.LatestPublishedVersionNumber is null && row.LatestDraftVersionNumber is null)
                {
                    <span class="mud-text-secondary">— sin versiones —</span>
                }
            </MudTd>
            <MudTd>
                @{
                    var ts = row.LatestPublishedAt ?? row.CreatedAt;
                }
                @ts.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<TemplateSummaryDto> _templates = Array.Empty<TemplateSummaryDto>();

    protected override async Task OnInitializedAsync()
    {
        try { _templates = await Api.ListTemplatesAsync(); }
        catch (Exception ex) { _error = $"No pude cargar plantillas: {ex.Message}"; }
        finally { _loading = false; }
    }

    private void OpenVersion(TemplateSummaryDto t)
    {
        // Preferimos publicada (read-only); si sólo hay draft, vamos al editor.
        if (t.LatestPublishedVersionId is { } pubId)
            Nav.NavigateTo($"/templates/versions/{pubId}");
        else if (t.LatestDraftVersionId is { } draftId)
            Nav.NavigateTo($"/templates/versions/{draftId}/edit");
    }
}
