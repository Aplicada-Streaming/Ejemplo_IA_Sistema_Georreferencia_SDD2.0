@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="2" Color="Color.Primary">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               OnClick="ToggleDrawer" Edge="Edge.Start" />
                <MudText Typo="Typo.h6">SGR — Vialidad</MudText>
                <MudSpacer />
                <MudText Typo="Typo.body2" Class="me-3">
                    @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    @if (context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value is { } role)
                    {
                        <span> · @role</span>
                    }
                </MudText>
                <form action="/auth/logout" method="post" style="display:inline;">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit"
                               Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Logout">
                        Salir
                    </MudButton>
                </form>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                        Dashboard
                    </MudNavLink>
                    <MudNavLink Href="/surveys" Icon="@Icons.Material.Filled.List">
                        Relevamientos
                    </MudNavLink>
                    <MudNavLink Href="/surveys/new" Icon="@Icons.Material.Filled.Add">
                        Nuevo relevamiento
                    </MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Un error inesperado ocurrió.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
