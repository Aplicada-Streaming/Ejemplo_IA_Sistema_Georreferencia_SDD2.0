@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@ElementId" style="@($"width:100%; height:{Height}; border-radius:8px; overflow:hidden;")"></div>

@code {
    [Parameter] public IReadOnlyList<MapMarker> Markers { get; set; } = Array.Empty<MapMarker>();
    [Parameter] public MapPoint? Center { get; set; }
    [Parameter] public int InitialZoom { get; set; } = 13;
    [Parameter] public string Height { get; set; } = "60vh";

    /// <summary>Si está seteado, cada marker dispara este callback cuando el usuario
    /// lo toca. El argumento es el <c>PointId</c> que el caller le asignó al marker.</summary>
    [Parameter] public EventCallback<Guid> OnMarkerClicked { get; set; }

    /// <summary>Si está seteado, cualquier click sobre el mapa dispara este callback
    /// con las coordenadas del punto. Útil para "picker" de georreferenciación manual (US-16).</summary>
    [Parameter] public EventCallback<MapPoint> OnMapClicked { get; set; }

    private readonly string ElementId = $"sgr-map-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<LeafletMap>? _selfRef;
    private bool _initialized;
    private IReadOnlyList<MapMarker>? _lastMarkers;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sgr-map.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", ElementId, new
            {
                center = Center is null ? null : new { lat = (double)Center.Latitude, lng = (double)Center.Longitude },
                zoom = InitialZoom,
            });
            _initialized = true;
            await PushMarkersAsync();

            if (OnMapClicked.HasDelegate)
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("enableMapClickPicker", ElementId, _selfRef);
            }
        }
        else if (_initialized && !ReferenceEquals(_lastMarkers, Markers))
        {
            await PushMarkersAsync();
        }
    }

    private async Task PushMarkersAsync()
    {
        if (_module is null) return;
        var payload = Markers.Select(m => new
        {
            pointId = m.PointId,
            lat = (double)m.Latitude,
            lng = (double)m.Longitude,
            title = m.Title,
            description = m.Description,
            accuracyM = m.AccuracyM is null ? null : (double?)Math.Round((double)m.AccuracyM.Value, 1),
            captureMode = m.CaptureMode,
            createdAt = m.CreatedAt?.ToString("o"),
        }).ToArray();
        // Sólo pasamos el ref a JS si hay handler registrado (evita interop cost si no se usa).
        var hasHandler = OnMarkerClicked.HasDelegate;
        await _module.InvokeVoidAsync("setMarkers", ElementId, payload, hasHandler ? _selfRef : null);
        _lastMarkers = Markers;
    }

    [JSInvokable]
    public Task OnMarkerClickedAsync(Guid pointId) =>
        OnMarkerClicked.HasDelegate ? OnMarkerClicked.InvokeAsync(pointId) : Task.CompletedTask;

    [JSInvokable]
    public Task OnMapClickedAsync(double lat, double lng) =>
        OnMapClicked.HasDelegate
            ? OnMapClicked.InvokeAsync(new MapPoint((decimal)lat, (decimal)lng))
            : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", ElementId); } catch { }
            try { await _module.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
    }

    public sealed record MapMarker(
        Guid PointId,
        decimal Latitude,
        decimal Longitude,
        string? Title,
        string? Description,
        decimal? AccuracyM,
        string? CaptureMode,
        DateTime? CreatedAt);

    public sealed record MapPoint(decimal Latitude, decimal Longitude);
}
