@page "/surveys/{SurveyId:guid}/points/new"
@attribute [Authorize]
@inject IOutboxEnqueueService Enqueue
@inject IOutboxDrainer Drainer
@inject IDialogService Dialogs
@inject ICameraCaptureService Camera
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>SGR · Capturar punto</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Nuevo punto</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.GpsFixed">
        Slice 3.3: GPS + foto vía outbox. El mapa y los modos detenido/móvil llegan en 3.4 / 3.5.
    </MudAlert>

    @* ---------- GPS ---------- *@
    @if (_lat is null || _lng is null)
    {
        <MudPaper Class="pa-4 mb-3" Elevation="0" Style="text-align:center; background: var(--mud-palette-background-grey);">
            <MudIcon Icon="@Icons.Material.Filled.LocationSearching"
                     Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">
                Aún no obtuviste la ubicación.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-3" Elevation="0" Style="background: var(--mud-palette-success-lighten);">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.MyLocation" Color="Color.Success" />
                <div>
                    <MudText Typo="Typo.body1">
                        <strong>lat</strong> @_lat.Value.ToString("F6") ·
                        <strong>lng</strong> @_lng.Value.ToString("F6")
                    </MudText>
                    @if (_accuracy is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Precisión: ±@_accuracy.Value.ToString("F1") m
                            @if (_lowAccuracy)
                            {
                                <span style="color: var(--mud-palette-warning);"> (baja)</span>
                            }
                        </MudText>
                    }
                </div>
            </MudStack>
        </MudPaper>
    }

    <MudButton Variant="@(_lat is null ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" FullWidth="true"
               StartIcon="@Icons.Material.Filled.GpsFixed"
               OnClick="OpenGpsDialogAsync"
               Disabled="_saving">
        @(_lat is null ? "Obtener GPS" : "Reintentar GPS")
    </MudButton>

    @* ---------- FOTO (E.3.3) ---------- *@
    <MudDivider Class="my-3" />

    @if (_photo is not null)
    {
        <MudPaper Class="pa-3 mb-2" Elevation="0" Style="background: var(--mud-palette-info-lighten);">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Info" />
                <div style="flex:1; min-width:0;">
                    <MudText Typo="Typo.body2"><strong>Foto lista</strong></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_photo.FileName · @FormatBytes(_photo.SizeBytes)
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               Disabled="_saving" OnClick="DiscardPhoto" />
            </MudStack>
        </MudPaper>
    }

    <MudButton Variant="@(_photo is null ? Variant.Filled : Variant.Outlined)"
               Color="Color.Secondary" FullWidth="true"
               StartIcon="@Icons.Material.Filled.PhotoCamera"
               OnClick="CapturePhotoAsync"
               Disabled="_saving || _capturingPhoto">
        @(_capturingPhoto ? "Abriendo cámara..." : (_photo is null ? "Tomar foto (opcional)" : "Re-tomar foto"))
    </MudButton>

    @* ---------- MODO + SUBMIT ---------- *@
    <MudSelect T="string" @bind-Value="_captureMode" Label="Modo de captura"
               Variant="Variant.Outlined" Class="mt-3" Disabled="_saving">
        <MudSelectItem Value="@("detenido")">Detenido</MudSelectItem>
        <MudSelectItem Value="@("movil")">Móvil</MudSelectItem>
    </MudSelect>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-4"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="@(_lat is null || _lng is null || _saving)" OnClick="SubmitAsync">
        @(_saving ? "Encolando..." : "Encolar en outbox")
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-2"
               OnClick="ResetAndContinue" Disabled="_saving">
        Limpiar (otro punto)
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-1"
               StartIcon="@Icons.Material.Filled.Map"
               Href="@($"/surveys/{SurveyId}/map")">
        Ver puntos en el mapa
    </MudButton>
</MudPaper>

@code {
    [Parameter] public Guid SurveyId { get; set; }

    private bool _saving;
    private bool _capturingPhoto;
    private string? _error;

    private decimal? _lat;
    private decimal? _lng;
    private decimal? _accuracy;
    private bool _lowAccuracy;
    private DateTime? _capturedAt;

    private string _captureMode = "detenido";

    private CameraCaptureResult.Ok? _photo;

    private async Task OpenGpsDialogAsync()
    {
        _error = null;
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            BackdropClick = false,
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
        };

        var dialogParams = new DialogParameters
        {
            ["Parameters"] = new GeolocationParams(
                TimeoutSeconds: 30,
                AccuracyThresholdMeters: 50.0,
                AllowContinueWithLowAccuracy: true,
                AllowManualEntry: false),
        };

        var dialog = await Dialogs.ShowAsync<Sgr.Frontend.Mobile.Components.Dialogs.GeolocationDialog>(
            "Capturar GPS", dialogParams, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is null) return;

        switch (result.Data)
        {
            case GeolocationResult.Ok ok:
                _lat = ok.Latitude;
                _lng = ok.Longitude;
                _accuracy = ok.AccuracyMeters;
                _capturedAt = ok.CapturedAtUtc;
                _lowAccuracy = false;
                break;
            case GeolocationResult.LowAccuracy low:
                _lat = low.Latitude;
                _lng = low.Longitude;
                _accuracy = low.AccuracyMeters;
                _capturedAt = low.CapturedAtUtc;
                _lowAccuracy = true;
                break;
        }
    }

    private async Task CapturePhotoAsync()
    {
        _error = null;
        _capturingPhoto = true;
        try
        {
            // Si ya había una foto previa cargada, la borramos antes de capturar otra,
            // para no acumular bytes en AppDataDirectory por descarte.
            DiscardPhoto();

            // Process-death resume: si Android mata el proceso mientras está la cámara,
            // queremos volver acá y no a "/". Se limpia abajo en el finally si todo OK.
            ProcessDeathResume.MarkResumePath($"/surveys/{SurveyId}/points/new");

            var photoId = Guid.NewGuid();
            var result = await Camera.CaptureAsync(photoId);

            switch (result)
            {
                case CameraCaptureResult.Ok ok:
                    _photo = ok;
                    Snackbar.Add($"Foto lista ({FormatBytes(ok.SizeBytes)}).", Severity.Success);
                    break;
                case CameraCaptureResult.Cancelled:
                    // silencioso
                    break;
                case CameraCaptureResult.PermissionDenied pd:
                    _error = pd.IsPermanent
                        ? "Permiso de cámara bloqueado. Activalo en los ajustes del sistema."
                        : "Necesitamos permiso de cámara para tomar la foto.";
                    break;
                case CameraCaptureResult.NotSupported:
                    _error = "Este dispositivo no tiene cámara o no la soporta.";
                    break;
                case CameraCaptureResult.Error err:
                    _error = $"Error al capturar: {err.Message}";
                    break;
            }
        }
        finally
        {
            // Si llegamos acá es porque NO hubo process-death (sobrevivimos al intent).
            // Limpiamos la marca para no redirigir al usuario en futuras sesiones.
            ProcessDeathResume.ClearResumePath();
            _capturingPhoto = false;
        }
    }

    private void DiscardPhoto()
    {
        if (_photo is null) return;
        try { if (File.Exists(_photo.LocalFilePath)) File.Delete(_photo.LocalFilePath); }
        catch { /* best-effort, no bloquea UX */ }
        _photo = null;
    }

    private async Task SubmitAsync()
    {
        if (_lat is null || _lng is null) return;

        _saving = true;
        _error = null;
        try
        {
            var pointId = Guid.NewGuid();
            var pointTimestamp = _capturedAt ?? DateTime.UtcNow;

            // 1) Encolamos PointCreated SIEMPRE primero — el server necesita el punto antes que la foto.
            var pointOpId = await Enqueue.EnqueuePointCreatedAsync(
                surveyId: SurveyId,
                pointId: pointId,
                latitude: _lat.Value,
                longitude: _lng.Value,
                accuracyM: _accuracy,
                captureMode: _captureMode,
                timestamp: pointTimestamp);

            // 2) Si hay foto, la encolamos después: el drainer respeta CreatedAt y procesa
            //    el evento del punto antes que la subida del binario.
            string? photoOpId = null;
            if (_photo is not null)
            {
                var photoId = Guid.NewGuid();
                photoOpId = await Enqueue.EnqueuePhotoCapturedAsync(
                    surveyId: SurveyId,
                    pointId: pointId,
                    photoId: photoId,
                    localFilePath: _photo.LocalFilePath,
                    fileName: _photo.FileName,
                    mimeType: _photo.MimeType,
                    comment: null,
                    capturedAt: _photo.CapturedAtUtc);

                // Importante: a partir de acá la foto pertenece al outbox; no la borramos local
                // hasta que el drainer confirme upload exitoso.
                _photo = null;
            }

            var msg = photoOpId is null
                ? $"Punto encolado (op {pointOpId[..8]}…). Se envía cuando haya conexión."
                : $"Punto + foto encolados (ops {pointOpId[..8]}…/{photoOpId[..8]}…). Se envían cuando haya conexión.";
            Snackbar.Add(msg, Severity.Success);

            _ = Drainer.DrainOnceAsync();
            ResetAndContinue();
        }
        catch (Exception ex)
        {
            _error = $"Error al encolar: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetAndContinue()
    {
        _lat = null;
        _lng = null;
        _accuracy = null;
        _lowAccuracy = false;
        _capturedAt = null;
        _captureMode = "detenido";
        _error = null;
        DiscardPhoto();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}
