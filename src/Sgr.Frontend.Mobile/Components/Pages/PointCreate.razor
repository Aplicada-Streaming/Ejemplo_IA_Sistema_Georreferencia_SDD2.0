@page "/surveys/{SurveyId:guid}/points/new"
@attribute [Authorize]
@inject IOutboxEnqueueService Enqueue
@inject IOutboxDrainer Drainer
@inject IDialogService Dialogs
@inject ICameraCaptureService Camera
@inject ICaptureProfileResolver CaptureProfile
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>SGR · Capturar punto</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Nuevo punto</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.GpsFixed">
        Slice 3.3: GPS + foto vía outbox. El mapa y los modos detenido/móvil llegan en 3.4 / 3.5.
    </MudAlert>

    @* ---------- GPS ---------- *@
    @if (_lat is null || _lng is null)
    {
        <MudPaper Class="pa-4 mb-3" Elevation="0" Style="text-align:center; background: var(--mud-palette-background-grey);">
            <MudIcon Icon="@Icons.Material.Filled.LocationSearching"
                     Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">
                Aún no obtuviste la ubicación.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-3" Elevation="0" Style="background: var(--mud-palette-success-lighten);">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.MyLocation" Color="Color.Success" />
                <div>
                    <MudText Typo="Typo.body1">
                        <strong>lat</strong> @_lat.Value.ToString("F6") ·
                        <strong>lng</strong> @_lng.Value.ToString("F6")
                    </MudText>
                    @if (_accuracy is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Precisión: ±@_accuracy.Value.ToString("F1") m
                            @if (_lowAccuracy)
                            {
                                <span style="color: var(--mud-palette-warning);"> (baja)</span>
                            }
                        </MudText>
                    }
                </div>
            </MudStack>
        </MudPaper>
    }

    <MudButton Variant="@(_lat is null ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" FullWidth="true"
               StartIcon="@Icons.Material.Filled.GpsFixed"
               OnClick="OpenGpsDialogAsync"
               Disabled="_saving">
        @(_lat is null ? "Obtener GPS" : "Reintentar GPS")
    </MudButton>

    @* ---------- FOTO (E.3.3) ---------- *@
    <MudDivider Class="my-3" />

    @if (_photo is not null)
    {
        <MudPaper Class="pa-3 mb-2" Elevation="0" Style="background: var(--mud-palette-info-lighten);">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Info" />
                <div style="flex:1; min-width:0;">
                    <MudText Typo="Typo.body2"><strong>Foto lista</strong></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_photo.FileName · @FormatBytes(_photo.SizeBytes)
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               Disabled="_saving" OnClick="DiscardPhoto" />
            </MudStack>
        </MudPaper>
    }

    <MudButton Variant="@(_photo is null ? Variant.Filled : Variant.Outlined)"
               Color="Color.Secondary" FullWidth="true"
               StartIcon="@Icons.Material.Filled.PhotoCamera"
               OnClick="CapturePhotoAsync"
               Disabled="_saving || _capturingPhoto">
        @(_capturingPhoto ? "Abriendo cámara..." : (_photo is null ? "Tomar foto (opcional)" : "Re-tomar foto"))
    </MudButton>

    @* ---------- CAMPOS DE PLANTILLA (E.5.b) ---------- *@
    @if (_fields.Count > 0)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Datos del punto</MudText>

        @foreach (var f in _fields)
        {
            <div class="mt-2">
                @switch (f.Type)
                {
                    case "fecha":
                        <MudDatePicker Label="@FieldLabel(f)" Editable="true"
                                       Date="@GetDate(f.Key)"
                                       DateChanged="@(d => SetDate(f.Key, d))"
                                       Disabled="_saving" />
                        break;
                    case "selección":
                        <MudSelect T="string" Label="@FieldLabel(f)"
                                   Value="@(GetString(f.Key) ?? string.Empty)"
                                   ValueChanged="@(v => SetString(f.Key, v))"
                                   Variant="Variant.Outlined" Disabled="_saving">
                            @foreach (var opt in f.Options ?? Array.Empty<string>())
                            {
                                <MudSelectItem Value="@opt">@opt</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    case "numero":
                        <MudNumericField T="decimal?" Label="@FieldLabel(f)"
                                         Value="@GetNumber(f.Key)"
                                         ValueChanged="@(n => SetNumber(f.Key, n))"
                                         Variant="Variant.Outlined" Disabled="_saving" />
                        break;
                    case "booleano":
                        <MudCheckBox T="bool" Label="@FieldLabel(f)"
                                     Value="@(GetBool(f.Key) ?? false)"
                                     ValueChanged="@(b => SetBool(f.Key, b))"
                                     Disabled="_saving" />
                        break;
                    default: // "texto" o desconocido
                        <MudTextField T="string" Label="@FieldLabel(f)"
                                      Value="@GetString(f.Key)"
                                      ValueChanged="@(v => SetString(f.Key, v))"
                                      Variant="Variant.Outlined" Disabled="_saving"
                                      Lines="@(f.Key == "observaciones" ? 3 : 1)" />
                        break;
                }
            </div>
        }
    }

    @* ---------- MODO + SUBMIT ---------- *@
    <MudSelect T="string" @bind-Value="_captureMode" Label="Modo de captura"
               Variant="Variant.Outlined" Class="mt-3" Disabled="_saving">
        <MudSelectItem Value="@("detenido")">Detenido</MudSelectItem>
        <MudSelectItem Value="@("movil")">Móvil</MudSelectItem>
    </MudSelect>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-4"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="@(_lat is null || _lng is null || _saving)" OnClick="SubmitAsync">
        @(_saving ? "Encolando..." : "Encolar en outbox")
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-2"
               OnClick="ResetAndContinue" Disabled="_saving">
        Limpiar (otro punto)
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-1"
               StartIcon="@Icons.Material.Filled.Map"
               Href="@($"/surveys/{SurveyId}/map")">
        Ver puntos en el mapa
    </MudButton>
</MudPaper>

@code {
    [Parameter] public Guid SurveyId { get; set; }

    private bool _saving;
    private bool _capturingPhoto;
    private string? _error;

    private decimal? _lat;
    private decimal? _lng;
    private decimal? _accuracy;
    private bool _lowAccuracy;
    private DateTime? _capturedAt;

    private string _captureMode = "detenido";

    private CameraCaptureResult.Ok? _photo;

    private IReadOnlyList<TemplateField> _fields = Array.Empty<TemplateField>();
    /// <summary>Valor en memoria por field key. Tipo dinámico: string | decimal | bool | DateTime | null.</summary>
    private readonly Dictionary<string, object?> _fieldValues = new();

    protected override async Task OnInitializedAsync()
    {
        _fields = await CaptureProfile.ResolveFieldsAsync(SurveyId);

        // DT-camera-state-resume: si veníamos del intent de cámara y el OS mató el proceso,
        // rehidratamos el state que dejamos guardado antes del intent. Restaurar SÓLO si
        // matchea el SurveyId actual (evita mezclar capturas si el resume fue de otro relev).
        var saved = ProcessDeathResume.TryConsumeState<PointCreateResumeState>();
        if (saved is not null && saved.SurveyId == SurveyId)
        {
            _lat = saved.Lat;
            _lng = saved.Lng;
            _accuracy = saved.AccuracyM;
            _lowAccuracy = saved.LowAccuracy;
            _capturedAt = saved.CapturedAtUtc;
            _captureMode = saved.CaptureMode ?? _captureMode;
            if (saved.FieldValues is not null)
            {
                foreach (var (k, v) in saved.FieldValues)
                    _fieldValues[k] = DeserializeRestoredValue(v);
            }
            // La foto física puede haber sobrevivido (vive en AppDataDirectory), restauramos
            // si el archivo todavía está. Si no, perdimos esa foto pero no el resto.
            if (saved.PhotoLocalPath is not null && File.Exists(saved.PhotoLocalPath))
            {
                _photo = new CameraCaptureResult.Ok(
                    LocalFilePath: saved.PhotoLocalPath,
                    FileName: saved.PhotoFileName ?? "photo.jpg",
                    MimeType: saved.PhotoMimeType ?? "image/jpeg",
                    SizeBytes: saved.PhotoSizeBytes ?? 0,
                    CapturedAtUtc: saved.PhotoCapturedAtUtc ?? DateTime.UtcNow);
            }
            Snackbar.Add("Se restauró la captura previa al cierre inesperado.", Severity.Info);
        }
    }

    /// <summary>
    /// Convierte un valor JSON almacenado a la representación in-memory que usan los inputs.
    /// JSON deserializa a JsonElement; lo desboxamos a string/decimal/bool/DateTime.
    /// </summary>
    private static object? DeserializeRestoredValue(object? raw)
    {
        if (raw is null) return null;
        if (raw is System.Text.Json.JsonElement el)
        {
            return el.ValueKind switch
            {
                System.Text.Json.JsonValueKind.String when DateTime.TryParse(el.GetString(),
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.RoundtripKind, out var dt) => (object)dt,
                System.Text.Json.JsonValueKind.String => el.GetString()!,
                System.Text.Json.JsonValueKind.Number => el.GetDecimal(),
                System.Text.Json.JsonValueKind.True => true,
                System.Text.Json.JsonValueKind.False => false,
                _ => null,
            };
        }
        return raw;
    }

    /// <summary>Snapshot serializado en Preferences antes de tirar el intent de cámara.</summary>
    private sealed record PointCreateResumeState(
        Guid SurveyId,
        decimal? Lat,
        decimal? Lng,
        decimal? AccuracyM,
        bool LowAccuracy,
        DateTime? CapturedAtUtc,
        string? CaptureMode,
        Dictionary<string, object?>? FieldValues,
        string? PhotoLocalPath,
        string? PhotoFileName,
        string? PhotoMimeType,
        long? PhotoSizeBytes,
        DateTime? PhotoCapturedAtUtc);

    private static string FieldLabel(TemplateField f) =>
        f.Required ? $"{f.Label} *" : f.Label;

    private string? GetString(string key) =>
        _fieldValues.TryGetValue(key, out var v) ? v as string : null;
    private decimal? GetNumber(string key) =>
        _fieldValues.TryGetValue(key, out var v) ? v as decimal? : null;
    private DateTime? GetDate(string key) =>
        _fieldValues.TryGetValue(key, out var v) ? v as DateTime? : null;
    private bool? GetBool(string key) =>
        _fieldValues.TryGetValue(key, out var v) ? v as bool? : null;

    private void SetString(string key, string? v) => _fieldValues[key] = v;
    private void SetNumber(string key, decimal? v) => _fieldValues[key] = v;
    private void SetDate(string key, DateTime? v) => _fieldValues[key] = v;
    private void SetBool(string key, bool v) => _fieldValues[key] = v;

    /// <summary>Convierte los valores en memoria a JSON crudo para el outbox.
    /// Devuelve null en valor cuando el campo está vacío y no es required.</summary>
    private Dictionary<string, string?> SerializeFieldValues()
    {
        var result = new Dictionary<string, string?>();
        foreach (var f in _fields)
        {
            if (!_fieldValues.TryGetValue(f.Key, out var raw) || raw is null) continue;
            string? json = raw switch
            {
                string s when string.IsNullOrEmpty(s) => null,
                string s => System.Text.Json.JsonSerializer.Serialize(s),
                decimal d => d.ToString(System.Globalization.CultureInfo.InvariantCulture),
                bool b => b ? "true" : "false",
                DateTime dt => System.Text.Json.JsonSerializer.Serialize(dt.ToString("yyyy-MM-dd")),
                _ => null,
            };
            if (json is not null)
                result[f.Key] = json;
        }
        return result;
    }

    private string? ValidateRequiredFields()
    {
        foreach (var f in _fields)
        {
            if (!f.Required) continue;
            var present = _fieldValues.TryGetValue(f.Key, out var v)
                && v is not null
                && (v is not string s || !string.IsNullOrWhiteSpace(s));
            if (!present)
                return $"Falta completar el campo requerido: {f.Label}";
        }
        return null;
    }

    private async Task OpenGpsDialogAsync()
    {
        _error = null;
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            BackdropClick = false,
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
        };

        // E.5.a: parámetros vienen del template publicado del relevamiento;
        // si no hay red ni cache, el resolver cae al hardcoded "detenido".
        var profile = await CaptureProfile.ResolveAsync(SurveyId, mode: "detenido");
        var dialogParams = new DialogParameters
        {
            ["Parameters"] = new GeolocationParams(
                TimeoutSeconds: profile.TimeoutSeconds,
                AccuracyThresholdMeters: profile.AccuracyThresholdMeters,
                AllowContinueWithLowAccuracy: profile.AllowContinueWithLowAccuracy,
                AllowManualEntry: false),
        };

        var dialog = await Dialogs.ShowAsync<Sgr.Frontend.Mobile.Components.Dialogs.GeolocationDialog>(
            "Capturar GPS", dialogParams, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is null) return;

        switch (result.Data)
        {
            case GeolocationResult.Ok ok:
                _lat = ok.Latitude;
                _lng = ok.Longitude;
                _accuracy = ok.AccuracyMeters;
                _capturedAt = ok.CapturedAtUtc;
                _lowAccuracy = false;
                break;
            case GeolocationResult.LowAccuracy low:
                _lat = low.Latitude;
                _lng = low.Longitude;
                _accuracy = low.AccuracyMeters;
                _capturedAt = low.CapturedAtUtc;
                _lowAccuracy = true;
                break;
        }
    }

    private async Task CapturePhotoAsync()
    {
        _error = null;
        _capturingPhoto = true;
        try
        {
            // Si ya había una foto previa cargada, la borramos antes de capturar otra,
            // para no acumular bytes en AppDataDirectory por descarte.
            DiscardPhoto();

            // Process-death resume: si Android mata el proceso mientras está la cámara,
            // queremos volver acá Y restaurar el state in-memory. Se limpia abajo en
            // el finally si todo sale OK (no hubo process-death).
            ProcessDeathResume.MarkResumePoint(
                $"/surveys/{SurveyId}/points/new",
                new PointCreateResumeState(
                    SurveyId: SurveyId,
                    Lat: _lat,
                    Lng: _lng,
                    AccuracyM: _accuracy,
                    LowAccuracy: _lowAccuracy,
                    CapturedAtUtc: _capturedAt,
                    CaptureMode: _captureMode,
                    FieldValues: new Dictionary<string, object?>(_fieldValues),
                    PhotoLocalPath: null,
                    PhotoFileName: null,
                    PhotoMimeType: null,
                    PhotoSizeBytes: null,
                    PhotoCapturedAtUtc: null));

            var photoId = Guid.NewGuid();
            var result = await Camera.CaptureAsync(photoId);

            switch (result)
            {
                case CameraCaptureResult.Ok ok:
                    _photo = ok;
                    Snackbar.Add($"Foto lista ({FormatBytes(ok.SizeBytes)}).", Severity.Success);
                    break;
                case CameraCaptureResult.Cancelled:
                    // silencioso
                    break;
                case CameraCaptureResult.PermissionDenied pd:
                    _error = pd.IsPermanent
                        ? "Permiso de cámara bloqueado. Activalo en los ajustes del sistema."
                        : "Necesitamos permiso de cámara para tomar la foto.";
                    break;
                case CameraCaptureResult.NotSupported:
                    _error = "Este dispositivo no tiene cámara o no la soporta.";
                    break;
                case CameraCaptureResult.Error err:
                    _error = $"Error al capturar: {err.Message}";
                    break;
            }
        }
        finally
        {
            // Si llegamos acá es porque NO hubo process-death (sobrevivimos al intent).
            // Limpiamos la marca para no redirigir al usuario en futuras sesiones.
            ProcessDeathResume.ClearResumePath();
            _capturingPhoto = false;
        }
    }

    private void DiscardPhoto()
    {
        if (_photo is null) return;
        try { if (File.Exists(_photo.LocalFilePath)) File.Delete(_photo.LocalFilePath); }
        catch { /* best-effort, no bloquea UX */ }
        _photo = null;
    }

    private async Task SubmitAsync()
    {
        if (_lat is null || _lng is null) return;

        // Valida campos requeridos antes de tocar el outbox.
        var missing = ValidateRequiredFields();
        if (missing is not null)
        {
            _error = missing;
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var pointId = Guid.NewGuid();
            var pointTimestamp = _capturedAt ?? DateTime.UtcNow;

            // 1) Encolamos PointCreated + field_updated en una sola op (todos los eventos
            //    van en la misma PendingOperation y se aplican atómicamente del lado server).
            var fieldsPayload = SerializeFieldValues();
            var pointOpId = await Enqueue.EnqueuePointCreatedAsync(
                surveyId: SurveyId,
                pointId: pointId,
                latitude: _lat.Value,
                longitude: _lng.Value,
                accuracyM: _accuracy,
                captureMode: _captureMode,
                timestamp: pointTimestamp,
                fieldValues: fieldsPayload);

            // 2) Si hay foto, la encolamos después: el drainer respeta CreatedAt y procesa
            //    el evento del punto antes que la subida del binario.
            string? photoOpId = null;
            if (_photo is not null)
            {
                var photoId = Guid.NewGuid();
                photoOpId = await Enqueue.EnqueuePhotoCapturedAsync(
                    surveyId: SurveyId,
                    pointId: pointId,
                    photoId: photoId,
                    localFilePath: _photo.LocalFilePath,
                    fileName: _photo.FileName,
                    mimeType: _photo.MimeType,
                    comment: null,
                    capturedAt: _photo.CapturedAtUtc);

                // Importante: a partir de acá la foto pertenece al outbox; no la borramos local
                // hasta que el drainer confirme upload exitoso.
                _photo = null;
            }

            var msg = photoOpId is null
                ? $"Punto encolado (op {pointOpId[..8]}…). Se envía cuando haya conexión."
                : $"Punto + foto encolados (ops {pointOpId[..8]}…/{photoOpId[..8]}…). Se envían cuando haya conexión.";
            Snackbar.Add(msg, Severity.Success);

            _ = Drainer.DrainOnceAsync();
            ResetAndContinue();
        }
        catch (Exception ex)
        {
            _error = $"Error al encolar: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetAndContinue()
    {
        _lat = null;
        _lng = null;
        _accuracy = null;
        _lowAccuracy = false;
        _capturedAt = null;
        _captureMode = "detenido";
        _error = null;
        _fieldValues.Clear();
        DiscardPhoto();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}
