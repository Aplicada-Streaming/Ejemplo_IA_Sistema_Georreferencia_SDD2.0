@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@ElementId" style="@($"width:100%; height:{Height}; border-radius:8px; overflow:hidden;")"></div>

@code {
    [Parameter] public IReadOnlyList<MapMarker> Markers { get; set; } = Array.Empty<MapMarker>();
    [Parameter] public MapPoint? Center { get; set; }
    [Parameter] public int InitialZoom { get; set; } = 13;
    [Parameter] public string Height { get; set; } = "60vh";

    private readonly string ElementId = $"sgr-map-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private bool _initialized;
    private IReadOnlyList<MapMarker>? _lastMarkers;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sgr-map.js");
            await _module.InvokeVoidAsync("init", ElementId, new
            {
                center = Center is null ? null : new { lat = (double)Center.Latitude, lng = (double)Center.Longitude },
                zoom = InitialZoom,
            });
            _initialized = true;
            await PushMarkersAsync();
        }
        else if (_initialized && !ReferenceEquals(_lastMarkers, Markers))
        {
            await PushMarkersAsync();
        }
    }

    private async Task PushMarkersAsync()
    {
        if (_module is null) return;
        var payload = Markers.Select(m => new
        {
            lat = (double)m.Latitude,
            lng = (double)m.Longitude,
            title = m.Title,
            description = m.Description,
            accuracyM = m.AccuracyM is null ? null : (double?)Math.Round((double)m.AccuracyM.Value, 1),
            captureMode = m.CaptureMode,
            createdAt = m.CreatedAt?.ToString("o"),
        }).ToArray();
        await _module.InvokeVoidAsync("setMarkers", ElementId, payload);
        _lastMarkers = Markers;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", ElementId); } catch { }
            try { await _module.DisposeAsync(); } catch { }
        }
    }

    public sealed record MapMarker(
        decimal Latitude,
        decimal Longitude,
        string? Title,
        string? Description,
        decimal? AccuracyM,
        string? CaptureMode,
        DateTime? CreatedAt);

    public sealed record MapPoint(decimal Latitude, decimal Longitude);
}
