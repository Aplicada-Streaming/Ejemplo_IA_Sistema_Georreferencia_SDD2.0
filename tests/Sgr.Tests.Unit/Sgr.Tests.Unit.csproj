<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- FluentAssertions queda en 7.x (último MIT). 8.x cambió a licencia comercial. Ver ADR-04. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sgr.Domain\Sgr.Domain.csproj" />
    <ProjectReference Include="..\..\src\Sgr.Modules.Identity\Sgr.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\src\Sgr.Modules.Surveys\Sgr.Modules.Surveys.csproj" />
    <ProjectReference Include="..\..\src\Sgr.Modules.Templates\Sgr.Modules.Templates.csproj" />
    <ProjectReference Include="..\..\src\Sgr.Modules.Points\Sgr.Modules.Points.csproj" />
    <ProjectReference Include="..\..\src\Sgr.Modules.Storage\Sgr.Modules.Storage.csproj" />
    <ProjectReference Include="..\..\src\Sgr.Modules.Sync\Sgr.Modules.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linkeamos código matemático puro del mobile (sin deps MAUI) para testearlo
         desde net10.0 plain. Sgr.Frontend.Mobile target net10.0-android no se
         puede referenciar como ProjectReference desde net10.0. -->
    <Compile Include="..\..\src\Sgr.Frontend.Mobile\Geolocation\Distance.cs"
             Link="Mobile\Distance.cs" />
  </ItemGroup>

</Project>
