# SGR — Plantilla de variables de entorno para deploy con Docker Compose.
# El wizard configure.bat genera el archivo .env real a partir de esta plantilla.
# Ningun valor lleva comillas; los espacios literales en passwords se respetan.

# ───── Docker Hub ─────
# User publico de DockerHub donde el dev publico las imagenes (sgr-backend, sgr-web, sgr-db).
DOCKERHUB_USER=fernandofilipuzzi

# ───── Host destino (la maquina donde corre Docker Desktop) ─────
# IP o hostname accesible desde los clientes web/mobile en la LAN.
# Para LAN tipica: la IP local (ej. 192.168.1.50). Para acceso solo local: localhost.
HOST_IP=192.168.1.50

# ───── Storage local del backend ─────
# Carpeta Windows donde se guardan las fotos. Sera bind-mounteada a /var/sgr/photos
# en el container del backend. Debe existir y ser escribible por Docker Desktop.
HOST_PHOTOS_PATH=C:\sgr\storage

# ───── SQL Server ─────
# Password de SA. Requisitos SQL Server: 8+ chars, mayus + minus + numero + simbolo.
SQL_SA_PASSWORD=Sgr_DB_StrongP@ss1

# ───── JWT ─────
# Clave de firma. Minimo 32 caracteres. NO commitear el .env real, solo .env.template.
JWT_SIGNING_KEY=REEMPLAZAR-CON-CLAVE-DE-AL-MENOS-32-CARACTERES-RANDOM

# ───── Seed (passwords iniciales de los usuarios pre-creados) ─────
# Cambiar al menos en produccion. El admin puede cambiarlas despues por UI.
SEED_ADMIN_PASSWORD=Admin1234!
SEED_JEFE_PASSWORD=Jefe1234!
SEED_RELEVADOR_PASSWORD=Relev1234!
